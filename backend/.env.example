# GreenCity Backend Environment Configuration Template
# Copy this file to .env and provide your deployment-specific settings.
# NEVER commit the actual .env file or production credentials to source control.

# Server settings
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Database settings (MySQL / Amazon RDS)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_USER=greencity_admin
DB_PASSWORD=YourSecureDatabasePassword
DB_NAME=greencity
DB_SSL=false

# Authentication
JWT_SECRET=generate-a-secure-random-256-bit-secret-here

# AWS Cloud Integration (EC2 / S3 / SSM / CloudWatch)
AWS_REGION=us-east-1
S3_BUCKET=greencity-complaints-bucket-unique-id
PUBLIC_API_URL=http://your-ec2-public-ip:5000

# AWS Systems Manager Parameter Store (optional secret injection)
USE_SSM=false
SSM_PREFIX=/greencity/prod

# Amazon CloudWatch Monitoring
ENABLE_CLOUDWATCH=false
CLOUDWATCH_LOG_GROUP=/greencity/backend
